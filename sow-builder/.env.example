# Anthropic credentials. Stages 0-3, the equipment interrogation, the
# assumptions pass and Word generation all work WITHOUT this - the document
# just carries plainer prose. Set it to enable the drafting pass (stage 4 of
# the build order) and floor plan reading.
ANTHROPIC_API_KEY=sk-ant-...

# Model used for every drafting and analysis pass.
SOW_MODEL=claude-opus-5

# Printed in the generated document wherever the contractor is named.
SOW_COMPANY_NAME=Acme Security Integration

PORT=3000
